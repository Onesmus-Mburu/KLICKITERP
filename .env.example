# Klickit Finance ERP — environment template
# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Grouped per docs/phase-3/03-deployment-infrastructure.md §3.

# --- Core ---
NODE_ENV=development
PORT=3000
TZ=Africa/Nairobi
BASE_URL=http://localhost:3000
SCHOOL_ID=dev-school

# --- apps/worker (ADR-003: BullMQ processors + cron, own container) ---
# Bare /health + /health/ready for the worker container — distinct port from apps/api's PORT above
WORKER_PORT=3001
# Outbox dispatcher poll cadence/batch (docs/phase-3/02-communication-authentication.md §1.3)
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100

# --- Database (kfe_app: DML-only role used at runtime) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klickit_dev
DB_USER=kfe_app
DB_PASSWORD=changeme
DB_SSL=false

# --- Database (kfe_migrate: DDL-only role, migrations only — never used at app boot) ---
DB_MIGRATION_USER=kfe_migrate
DB_MIGRATION_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
# ES256 PEM keypairs, rotatable with overlap window (kid header selects the active key)
JWT_KEY_CURRENT=
JWT_KEY_PREVIOUS=
# AES-256 master key used to envelope-encrypt stored credentials/secrets (base64, 32 bytes)
APP_ENCRYPTION_KEY=

# --- Storage (MinIO / S3-compatible object store — Module 3 Files) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEFAULT=klickit-files
MINIO_USE_SSL=false
# Upload guardrails (files.module) — bytes, comma-separated MIME allow-list
FILE_MAX_UPLOAD_BYTES=26214400
FILE_ALLOWED_MIME_TYPES=

# --- Integrations (Module 19) ---
# FR-INTG-007.1 auto-disable admin alert recipient (best-effort NotificationsService EMAIL send)
INTEGRATIONS_ADMIN_ALERT_EMAIL=

# --- Backups & Ops (Module 20) ---
# AES-256-GCM passphrase encrypting every backup archive — schools told: lose this = backups unreadable
BACKUP_PASSPHRASE=
# Local on-disk backup destination (7 daily, GFS rotation)
BACKUP_LOCAL_DIR=./data/backups
# MinIO bucket for the weekly (4) backup mirror — distinct from MINIO_BUCKET_DEFAULT (Module 3 Files)
BACKUP_MINIO_BUCKET=klickit-backups
# Optional offsite S3 (12 monthly, school-chosen) is NOT an env var — configured at runtime via the
# generic Settings key/value store (backups.offsite_s3.*, see OffsiteS3Adapter's own doc comment),
# consistent with "runtime-changeable settings live in the DB, .env is infrastructure-only" (docs/phase-3/03 §3)

# --- Licensing (Module 21) — isolated `license` schema, FR-LIC-001..006 ---
# Ed25519 PEM public key(s) baked in at build/release time — Infoney's own keypair; the matching
# private key never lives in this codebase. JSON {kid, publicKey}. Verifies BOTH a license file's
# signature and inbound Super Admin portal JWS requests (docs/phase-3/02-communication-authentication.md
# §2.6). Rotatable with an overlap window (kid header selects which key verifies), same convention
# as JWT_KEY_CURRENT/PREVIOUS above.
INFONEY_LICENSE_PUBLIC_KEY_CURRENT=
INFONEY_LICENSE_PUBLIC_KEY_PREVIOUS=
# This instance's own Ed25519 private key (PEM) — signs outbound /license/v1/* responses; its
# public half is registered with the Infoney Super Admin portal at provisioning time.
INSTANCE_PRIVATE_KEY=
# Filesystem path to the signed license file this instance validates at boot + every 6h (FR-LIC-001.1)
LICENSE_FILE_PATH=./data/license/license.json
